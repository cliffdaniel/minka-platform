# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=minka
POSTGRES_PASSWORD=minka_secret
POSTGRES_DB=minka_db
POSTGRES_PORT=5432

# ─── Backend (NestJS) ─────────────────────────────────────────────────────────
BACKEND_PORT=4000
DATABASE_URL=postgresql://minka:minka_secret@postgres:5432/minka_db

# ─── Web (Next.js) ────────────────────────────────────────────────────────────
WEB_PORT=3000
# URL pública del API (usada en el browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Mobile (Metro Bundler) ───────────────────────────────────────────────────
METRO_PORT=8081
